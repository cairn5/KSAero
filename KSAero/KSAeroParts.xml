<?xml version="1.0" encoding="utf-8"?>
<!--
  KSAero's control surfaces. Each fin is one part: a fixed root that attaches to a hull like a
  landing leg (a ToSurface connector at the part origin), and a blade subpart that KSAero turns
  about the part's X axis. X is the span axis: the blade runs from the root at X = 0 out to -X.
  The chord runs along Z and the thickness along Y.

  The blade carries its own box collider, which stock 5901 aero builds its mesh from. The collider
  is 10 mm thick, thinner than the 35 mm panel it wears, so the aero mesh always makes the blade a
  zero-depth sheet: KSAero then turns the sheet's panels in place (FinAeroPanels.cs) rather than
  re-meshing the vehicle. The blade mesh is the stock flat panel of the same size, turned on edge;
  KSAero has no meshes of its own yet.
-->
<Assets>
  <EditorTagDef Id="Aero" />

  <!-- 1 m span x 1 m chord. The stock 1 m panel is 1 x 1 m in its XY plane and 35 mm thick in Z;
       turned a quarter turn about X it lies in the fin's XZ plane. -->
  <SubPart Id="KSAero_Subpart_FinBlade1m">
    <Components>
      <PartModel Key="KSAero_Subpart_FinBlade1m_Model">
        <Mesh Ref="CoreStructuralA_Subpart_PanelFA" />
        <Material Ref="CoreStructuralA_Material" />
      </PartModel>
      <MeshView>
        <Mesh Ref="CoreStructuralA_Subpart_PanelFA_VM" />
      </MeshView>
      <Collider Key="BladeCollider">
        <Colliders>
          <Box Key="BladeBox">
            <LocationAsmb X="0" Y="0" Z="0" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="1" />
            <LengthY M="1" />
            <LengthZ M="0.01" />
          </Box>
        </Colliders>
      </Collider>
    </Components>
  </SubPart>

  <Part Id="KSAero_AllMovingFin1m" DisplayName="All-Moving Fin 1 m">
    <SubParts>
      <SubPart Key="Blade" Ref="KSAero_Subpart_FinBlade1m">
        <Transform>
          <Position X="-0.5" />
          <Rotation X="1.5708" />
        </Transform>
      </SubPart>
    </SubParts>
    <Connectors>
      <!-- At the root, facing -X: the editor seats this point on the hull with -X along the
           surface normal, so the blade stands straight out. -->
      <Connector Key="Root">
        <Transform>
          <Position X="0" />
        </Transform>
        <Flags>ToSurface</Flags>
      </Connector>
    </Connectors>
    <InertMasses>
      <SolidCuboidMass>
        <Mass Kg="40" />
        <LocationAsmb X="-0.5" />
        <LengthX M="1" />
        <LengthY M="0.035" />
        <LengthZ M="1" />
      </SolidCuboidMass>
    </InertMasses>
    <EditorTags>
      <EditorTag Ref="Aero" />
    </EditorTags>
  </Part>

  <!-- 2 m span x 2 m chord, from the stock 2 m panel. -->
  <SubPart Id="KSAero_Subpart_FinBlade2m">
    <Components>
      <PartModel Key="KSAero_Subpart_FinBlade2m_Model">
        <Mesh Ref="CoreStructuralA_Subpart_PanelHA" />
        <Material Ref="CoreStructuralA_Material" />
      </PartModel>
      <MeshView>
        <Mesh Ref="CoreStructuralA_Subpart_PanelHA_VM" />
      </MeshView>
      <Collider Key="BladeCollider">
        <Colliders>
          <Box Key="BladeBox">
            <LocationAsmb X="0" Y="0" Z="0" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="2" />
            <LengthY M="2" />
            <LengthZ M="0.01" />
          </Box>
        </Colliders>
      </Collider>
    </Components>
  </SubPart>

  <Part Id="KSAero_AllMovingFin2m" DisplayName="All-Moving Fin 2 m">
    <SubParts>
      <SubPart Key="Blade" Ref="KSAero_Subpart_FinBlade2m">
        <Transform>
          <Position X="-1" />
          <Rotation X="1.5708" />
        </Transform>
      </SubPart>
    </SubParts>
    <Connectors>
      <Connector Key="Root">
        <Transform>
          <Position X="0" />
        </Transform>
        <Flags>ToSurface</Flags>
      </Connector>
    </Connectors>
    <InertMasses>
      <SolidCuboidMass>
        <Mass Kg="160" />
        <LocationAsmb X="-1" />
        <LengthX M="2" />
        <LengthY M="0.035" />
        <LengthZ M="2" />
      </SolidCuboidMass>
    </InertMasses>
    <EditorTags>
      <EditorTag Ref="Aero" />
    </EditorTags>
  </Part>
  <!-- 3 m span x 3 m chord. There is no stock 3 m panel, so the look is the 2 m panel scaled 1.5x in
       its plane, on a subpart of its own: a subpart's colliders scale with it, so the collider sits
       on a second, unscaled subpart. FinActuators turns both. -->
  <SubPart Id="KSAero_Subpart_FinBladeLook3m">
    <Components>
      <PartModel Key="KSAero_Subpart_FinBladeLook3m_Model">
        <Mesh Ref="CoreStructuralA_Subpart_PanelHA" />
        <Material Ref="CoreStructuralA_Material" />
      </PartModel>
      <MeshView>
        <Mesh Ref="CoreStructuralA_Subpart_PanelHA_VM" />
      </MeshView>
    </Components>
  </SubPart>

  <SubPart Id="KSAero_Subpart_FinBlade3m">
    <Components>
      <Collider Key="BladeCollider">
        <Colliders>
          <Box Key="BladeBox">
            <LocationAsmb X="0" Y="0" Z="0" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="3" />
            <LengthY M="3" />
            <LengthZ M="0.01" />
          </Box>
        </Colliders>
      </Collider>
    </Components>
  </SubPart>

  <Part Id="KSAero_AllMovingFin3m" DisplayName="All-Moving Fin 3 m">
    <SubParts>
      <SubPart Key="BladeLook" Ref="KSAero_Subpart_FinBladeLook3m">
        <Transform>
          <Position X="-1.5" />
          <Rotation X="1.5708" />
          <Scale X="1.5" Y="1.5" Z="1" />
        </Transform>
      </SubPart>
      <SubPart Key="Blade" Ref="KSAero_Subpart_FinBlade3m">
        <Transform>
          <Position X="-1.5" />
          <Rotation X="1.5708" />
        </Transform>
      </SubPart>
    </SubParts>
    <Connectors>
      <Connector Key="Root">
        <Transform>
          <Position X="0" />
        </Transform>
        <Flags>ToSurface</Flags>
      </Connector>
    </Connectors>
    <InertMasses>
      <SolidCuboidMass>
        <Mass Kg="360" />
        <LocationAsmb X="-1.5" />
        <LengthX M="3" />
        <LengthY M="0.035" />
        <LengthZ M="3" />
      </SolidCuboidMass>
    </InertMasses>
    <EditorTags>
      <EditorTag Ref="Aero" />
    </EditorTags>
  </Part>
</Assets>
